{
  "name": "dragabyte",
  "private": true,
  "version": "0.7.4",
  "type": "module",
  "workspaces": [
    "apps/client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @dragabyte/client --",
    "build": "npm run build:app",
    "build:app": "npm run build --workspace @dragabyte/client --",
    "preview": "npm run preview --workspace @dragabyte/client --",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test:scan": "npm run test:scan --workspace @dragabyte/client --",
    "test:version": "node --test scripts/version.test.cjs",
    "tauri": "npm run tauri --workspace @dragabyte/client --",
    "tauri:dev": "npm run tauri:dev --workspace @dragabyte/client --",
    "tauri:build": "npm run tauri:build --workspace @dragabyte/client --",
    "tauri:build:microsoft-store": "npm run tauri:build:microsoft-store --workspace @dragabyte/client --",
    "tauri:build:linux": "npm run tauri:build:linux --workspace @dragabyte/client --",
    "cli": "cargo run --manifest-path apps/client/src-tauri/Cargo.toml --bin dragabyte-cli --",
    "cli:build": "cargo build --manifest-path apps/client/src-tauri/Cargo.toml --release --bin dragabyte-cli",
    "cli:test": "cargo test --manifest-path apps/client/src-tauri/Cargo.toml --lib --bin dragabyte-cli --tests",
    "sync:version": "node scripts/sync-version.cjs",
    "sync:version:check": "node scripts/sync-version.cjs --check",
    "bump:patch": "node scripts/bump-version.cjs patch",
    "bump:minor": "node scripts/bump-version.cjs minor",
    "bump:major": "node scripts/bump-version.cjs major"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
